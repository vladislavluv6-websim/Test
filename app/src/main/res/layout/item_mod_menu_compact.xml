<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="54dp"
    android:layout_marginStart="4dp"
    android:layout_marginTop="3dp"
    android:layout_marginEnd="4dp"
    android:layout_marginBottom="3dp"
    android:defaultFocusHighlightEnabled="false"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="#0F131C"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:cardPreventCornerOverlap="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mod_card_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#CECFD2"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mod_card_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#727279"
                android:textSize="9sp"
                android:visibility="gone" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/mod_card_config"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:defaultFocusHighlightEnabled="false"
            android:padding="5dp"
            android:src="@drawable/ic_settings"
            android:tint="#727279" />

        <ImageButton
            android:id="@+id/mod_card_favorite"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:defaultFocusHighlightEnabled="false"
            android:padding="5dp"
            android:src="@drawable/ic_star"
            android:tint="#727279" />

        <Switch
            android:id="@+id/mod_card_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:defaultFocusHighlightEnabled="false"
            android:showText="false"
            android:switchMinWidth="36dp"
            android:thumbTint="@color/zenix_switch_thumb"
            android:trackTint="@color/zenix_switch_track" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
